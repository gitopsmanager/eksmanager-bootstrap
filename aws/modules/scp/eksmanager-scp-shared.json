{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProtectEKSManagerIdentities",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerAgentRole",
        "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerBootstrapSharedRole",
        "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerBootstrapGithubActionsRole",
        "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerLetsEncryptGithubActionsRole",
        "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerPrefixListsGithubActionsRole",
        "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManager-push-ecr",
        "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerLetsEncryptRole",
        "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerEcrPushTrustSyncRole"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/AWSControlTowerExecution",
            "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerBootstrapSharedRole",
            "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerEcrPushTrustSyncRole",
            "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerLetsEncryptPolicySyncRole"
          ]
        }
      }
    },
    {
      "Sid": "ProtectEKSManagerSecrets",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecret",
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:RestoreSecret",
        "secretsmanager:PutResourcePolicy"
      ],
      "Resource": [
        "arn:aws:secretsmanager:*:{{SHARED_SERVICES_ACCOUNT_ID}}:secret:/EKSManager/*",
        "arn:aws:secretsmanager:*:{{SHARED_SERVICES_ACCOUNT_ID}}:secret:/EKSManagerZones/*"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/AWSControlTowerExecution",
            "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerAgentRole",
            "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerLetsEncryptRole",
            "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerBootstrapSharedRole"
          ]
        }
      }
    },
    {
      "Sid": "ProtectEKSManagerBootstrapSecretsFromDeletion",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:DeleteSecret"
      ],
      "Resource": "arn:aws:secretsmanager:*:{{SHARED_SERVICES_ACCOUNT_ID}}:secret:/EKSManagerBootstrap/*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/AWSControlTowerExecution",
            "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerBootstrapSharedRole"
          ]
        }
      }
    },
    {
      "Sid": "ProtectEKSManagerKey",
      "Effect": "Deny",
      "Action": [
        "kms:PutKeyPolicy",
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey",
        "kms:DisableKeyRotation",
        "kms:DeleteAlias",
        "kms:UpdateAlias"
      ],
      "Resource": [
        "arn:aws:kms:*:{{SHARED_SERVICES_ACCOUNT_ID}}:key/*",
        "arn:aws:kms:*:{{SHARED_SERVICES_ACCOUNT_ID}}:alias/EKSManagerCMK"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/AWSControlTowerExecution",
            "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerBootstrapSharedRole"
          ]
        }
      }
    },
    {
      "Sid": "ProtectEKSManagerControlData",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:DeleteBucket",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters",
        "ssm:LabelParameterVersion"
      ],
      "Resource": [
        "arn:aws:s3:::eks-manager-config-store-{{SHARED_SERVICES_ACCOUNT_ID}}",
        "arn:aws:s3:::eks-manager-config-store-{{SHARED_SERVICES_ACCOUNT_ID}}/*",
        "arn:aws:ssm:*:{{SHARED_SERVICES_ACCOUNT_ID}}:parameter/EKSManager/*"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/OrganizationAccountAccessRole",
            "arn:aws:iam::*:role/AWSControlTowerExecution",
            "arn:aws:iam::{{SHARED_SERVICES_ACCOUNT_ID}}:role/EKSManagerBootstrapSharedRole"
          ]
        }
      }
    }
  ]
}
